# Public media base used by the Next.js app.
# This value is exposed to the browser because it starts with NEXT_PUBLIC_.
# Local default is /media. Production should be the R2 custom domain.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.paper-planet.com

# Cloudflare R2 upload settings.
# Do not prefix these with NEXT_PUBLIC_; they must stay server/local-only.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=paper-planet-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com

# Optional convenience values for future upload scripts.
R2_PUBLIC_MEDIA_DOMAIN=https://media.paper-planet.com
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# Admin area. Set these in Vercel before using /admin.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional override for admin-uploaded audio objects.
R2_AUDIO_CACHE_CONTROL=public, max-age=31536000, immutable
